# 极简论坛 · Apache 配置
# 关闭目录列表，拦截日志与锁文件
Options -Indexes

<IfModule mod_authz_core.c>
  <FilesMatch "\.(log|lock|tmp)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(log|lock|tmp)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# 极简论坛 · Apache 配置
# 关闭目录列表，拦截日志与锁文件
Options -Indexes

# v1.42.0 自制错误页：403 / 404 / 413 / 500 / 502 / 503 全面替代服务器默认样式
# （error/*.html 为零依赖静态页，PHP 宕机时也能原样出站）
# 注：论坛部署在子目录时，请把下面的 /error/... 改为 /子目录/error/...
ErrorDocument 403 /error/403.html
ErrorDocument 404 /error/404.html
ErrorDocument 413 /error/413.html
ErrorDocument 500 /error/500.html
ErrorDocument 502 /error/502.html
ErrorDocument 503 /error/503.html

<IfModule mod_authz_core.c>
  <FilesMatch "\.(log|lock|tmp)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(log|lock|tmp)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# v1.16.0：静态资源浏览器缓存（Apache；其他服务器环境由 CDN/浏览器协商缓存兜底）
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
